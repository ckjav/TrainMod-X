CREATE TABLE Session (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    trainingDayId INTEGER NOT NULL,
    startTime INTEGER NOT NULL,
    endTime INTEGER,
    isCompleted INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (trainingDayId) REFERENCES TrainingDay(id) ON DELETE CASCADE
);

insert:
INSERT INTO Session (trainingDayId, startTime, isCompleted)
VALUES (?, ?, 0);

getById:
SELECT * FROM Session WHERE id = ?;

getByDay:
SELECT * FROM Session WHERE trainingDayId = ? ORDER BY startTime DESC;

getAll:
SELECT * FROM Session ORDER BY startTime DESC;

update:
UPDATE Session SET endTime = ?, isCompleted = ? WHERE id = ?;