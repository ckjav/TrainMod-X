CREATE TABLE Week (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    planId INTEGER NOT NULL,
    number INTEGER NOT NULL,
    isDeload INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (planId) REFERENCES Plan(id) ON DELETE CASCADE
);

insert:
INSERT INTO Week (planId, number, isDeload)
VALUES (?, ?, ?);

getByPlan:
SELECT * FROM Week WHERE planId = ? ORDER BY number ASC;

update:
UPDATE Week SET isDeload = ? WHERE id = ?;

deleteById:
DELETE FROM Week WHERE id = ?;